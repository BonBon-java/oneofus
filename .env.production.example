# Review each value with the release operator. Do not put credentials in Git.
ONE_OF_US_ENV=production
ONE_OF_US_PAYMENT_MODE=mainnet
DATABASE_URL=postgresql://oneofus:replace-me@db.example/oneofus?sslmode=require
ONE_OF_US_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
ARBITRUM_RPC_URL=https://replace-with-primary-rpc.example/rpc
ARBITRUM_RPC_FALLBACK_URL=https://replace-with-independent-rpc.example/rpc
PAYMENT_CONFIRMATIONS=20
PAYMENT_POLL_INTERVAL_MS=15000
ONE_OF_US_RPC_TIMEOUT_MS=10000
ONE_OF_US_RPC_ATTEMPTS=3
ONE_OF_US_SCAN_MAX_BLOCKS=500
ONE_OF_US_SCHEDULER_ENABLED=false
# Mainnet payout is deliberately disabled until an external signer integration is reviewed.
ONE_OF_US_PAYOUT_MODE=
