# Review each value with the release operator. Do not put credentials in Git.
ONE_OF_US_ENV=production
ONE_OF_US_PAYMENT_MODE=mainnet
DATABASE_URL=postgresql://oneofus:replace-me@db.example/oneofus?sslmode=require
ONE_OF_US_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
ARBITRUM_RPC_URL=https://replace-with-primary-rpc.example/rpc
ARBITRUM_RPC_FALLBACK_URL=https://replace-with-independent-rpc.example/rpc
PAYMENT_CONFIRMATIONS=20
PAYMENT_POLL_INTERVAL_MS=15000
ONE_OF_US_RPC_TIMEOUT_MS=10000
ONE_OF_US_RPC_ATTEMPTS=3
ONE_OF_US_SCAN_MAX_BLOCKS=500
ONE_OF_US_SCHEDULER_ENABLED=false
# Payout is fail-closed. A raw private key (including PRIVATE_KEY) is forbidden here.
PAYOUT_ENABLED=false
# Required only when PAYOUT_ENABLED=true. The backend uses an isolated KMS/MPC signer service.
PAYOUT_SIGNER_MODE=production-external
PAYOUT_EXPECTED_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
PAYOUT_SIGNER_URL=https://signer.example.internal
# Secret: workload identity token or short-lived service credential; never commit.
PAYOUT_SIGNER_AUTH_TOKEN=
# Conservative operator-selected integer base-unit limits (USDT has 6 decimals).
MAX_SINGLE_PAYOUT_BASE_UNITS=
MIN_GAS_BALANCE_WEI=
# Production payout is disabled unless every value below is explicitly set.
PAYOUT_ENABLED=false
PAYOUT_SIGNER_MODE=production-external
PAYOUT_EXPECTED_SIGNER_ADDRESS=
PAYOUT_TREASURY_ADDRESS=
PAYOUT_SIGNER_URL=
PAYOUT_SIGNER_AUTH_TOKEN=
AWS_REGION=
AWS_KMS_KEY_ID=
MAX_SINGLE_PAYOUT_BASE_UNITS=
MIN_GAS_BALANCE_WEI=
REPORTING_AUTH_TOKEN=
GAS_WARNING_WEI=
GAS_CRITICAL_WEI=
