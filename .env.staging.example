# PUBLIC values — Arbitrum Sepolia only. Replace placeholders outside Git.
ONE_OF_US_ENV=staging
ONE_OF_US_PAYMENT_MODE=staging
# SECRET — a dedicated managed PostgreSQL database; never reuse local/production.
DATABASE_URL=postgresql://oneofus:replace-me@db.example/oneofus_staging?sslmode=require
ONE_OF_US_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
# SENSITIVE/SECRET when provider URLs contain keys. Use independently operated endpoints.
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK_URL=https://replace-with-independent-provider.example/rpc
# Deploy a dedicated 6-decimal test token; never use Arbitrum One USDT here.
ONE_OF_US_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_CONFIRMATIONS=12
PAYMENT_POLL_INTERVAL_MS=15000
ONE_OF_US_RPC_TIMEOUT_MS=10000
ONE_OF_US_RPC_ATTEMPTS=3
ONE_OF_US_SCAN_MAX_BLOCKS=500
ONE_OF_US_SCHEDULER_ENABLED=false
# Keep disabled until an explicitly funded staging signer is configured.
ONE_OF_US_PAYOUT_MODE=
ONE_OF_US_PAYOUT_RPC_URL=
ONE_OF_US_PAYOUT_CHAIN_ID=421614
ONE_OF_US_PAYOUT_TOKEN_ADDRESS=
ONE_OF_US_PAYOUT_TOKEN_DECIMALS=6
# Use aws-kms only for the test key validated by payout:kms-smoke. It is rejected
# outside Arbitrum Sepolia staging and requires no raw private key.
ONE_OF_US_PAYOUT_SIGNER_MODE=
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_KMS_EXPECTED_KEY_ARN=
PAYOUT_EXPECTED_SIGNER_ADDRESS=
# SECRET — disposable Arbitrum Sepolia signer only; never add a value to this file.
ONE_OF_US_PAYOUT_PRIVATE_KEY=
# PUBLIC deployment URLs, consumed only by the manual staging smoke workflow.
STAGING_API_URL=https://replace-with-staging-api.example
STAGING_FRONTEND_URL=https://replace-with-staging-ui.example
