# Arbitrum Sepolia only. Values are intentionally non-secret placeholders.
ONE_OF_US_ENV=staging
ONE_OF_US_PAYMENT_MODE=staging
DATABASE_URL=postgresql://oneofus:replace-me@localhost:5432/oneofus_staging?sslmode=require
ONE_OF_US_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK_URL=https://replace-with-independent-provider.example/rpc
# Deploy a dedicated 6-decimal test token; never use Arbitrum One USDT here.
ONE_OF_US_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_CONFIRMATIONS=12
PAYMENT_POLL_INTERVAL_MS=15000
ONE_OF_US_RPC_TIMEOUT_MS=10000
ONE_OF_US_RPC_ATTEMPTS=3
ONE_OF_US_SCAN_MAX_BLOCKS=500
ONE_OF_US_SCHEDULER_ENABLED=false
ONE_OF_US_PAYOUT_MODE=
