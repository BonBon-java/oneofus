# Generated automatically by `npm run local:integration:start`; never commit
# .env.integration.local. These values only target the disposable local stack.
DATABASE_URL=postgresql://oneofus:local-integration-only@127.0.0.1:5434/oneofus_integration
ONE_OF_US_PAYOUT_MODE=testnet
ONE_OF_US_PAYOUT_RPC_URL=http://127.0.0.1:8545
ONE_OF_US_PAYOUT_CHAIN_ID=31337
ONE_OF_US_PAYOUT_TOKEN_ADDRESS=<written-by-local-start>
ONE_OF_US_PAYOUT_TOKEN_DECIMALS=6
PAYOUT_MODE=test
POOL_WALLET_ADDRESS=<local-test-pool-address>
TREASURY_WALLET_ADDRESS=<local-test-treasury-address>
# The private key and deterministic test addresses are written only to the ignored
# .env.integration.local file by the local bootstrap.
PAYMENT_CONFIRMATIONS=1
RUN_PAYOUT_INTEGRATION_TESTS=true
