# Required in production. Never expose either value in frontend source.
ONE_OF_US_RECEIVING_ADDRESS=0x9C5DdDC861b60b0DCE772D9b0924C92E14D3Bf02
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK_URL=
ONE_OF_US_ENV=production
# Incoming-payment monitoring above remains Arbitrum One only. Payout execution
# is disabled unless every test-only variable below is set exactly as shown.
ONE_OF_US_PAYOUT_MODE=
ONE_OF_US_PAYOUT_RPC_URL=
ONE_OF_US_PAYOUT_CHAIN_ID=
ONE_OF_US_PAYOUT_TOKEN_ADDRESS=
ONE_OF_US_PAYOUT_TOKEN_DECIMALS=6
# Dedicated test-only signer for MockUSDT. Never commit a real key.
ONE_OF_US_PAYOUT_PRIVATE_KEY=
RUN_PAYOUT_INTEGRATION_TESTS=false
PAYOUT_TEST_WINNER_ADDRESS=
PAYOUT_TEST_AMOUNT_UNITS=1000001
DATABASE_URL=postgresql://oneofus:change-me-for-local-development@localhost:5432/oneofus
PORT=4174
PAYMENT_RESERVATION_MINUTES=30
PAYMENT_CODE_COOLDOWN_MINUTES=120
PAYMENT_CONFIRMATIONS=3
PAYMENT_POLL_INTERVAL_MS=15000
ONE_OF_US_RPC_TIMEOUT_MS=10000
ONE_OF_US_RPC_ATTEMPTS=3
ONE_OF_US_SCAN_MAX_BLOCKS=500
ONE_OF_US_SCHEDULER_ENABLED=false
ONE_OF_US_SCHEDULER_INTERVAL_MS=15000
